{
  "name": "fansly-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP integral para automatización y analítica en Fansly",
  "type": "module",
  "bin": {
    "fansly-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "login": "tsx scripts/login.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.4.5",
    "playwright": "1.58.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "esbuild@0.28.1": true
  }
}
