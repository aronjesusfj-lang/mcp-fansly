# Directorio del perfil persistente del navegador Chromium
USER_DATA_DIR="./browser_data"

# Ruta del archivo de base de datos SQLite
DB_PATH="./fansly_analytics.db"

# true = headless | false = ventana visible (necesario para la primera autenticación manual)
HEADLESS="false"

# Token de sesión de Fansly (opcional). Si se define, se usa directamente sin abrir navegador.
# Obtenlo en fansly.com con DevTools -> Console:
#   JSON.parse(localStorage.getItem("session_active_session")).token
FANSLY_TOKEN=""

# Número máximo de reintentos del motor resiliente
MAX_RETRIES="3"

# Base del backoff exponencial en milisegundos
BACKOFF_BASE_MS="1000"

# Timeout por petición HTTP en milisegundos
REQUEST_TIMEOUT_MS="30000"
