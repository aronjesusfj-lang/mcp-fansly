# Directorio del perfil persistente del navegador Chromium (modo browser)
USER_DATA_DIR="./browser_data"

# Ruta del archivo de base de datos SQLite
DB_PATH="./fansly_analytics.db"

# true = headless | false = ventana visible (necesario para el login manual)
HEADLESS="false"

# Token de sesión de Fansly (opcional, PRIORIDAD 1). Si se define, se usa sin abrir navegador.
# Obtenlo en fansly.com con DevTools -> Console:
#   JSON.parse(localStorage.getItem("session_active_session")).token
FANSLY_TOKEN=""

# URL de Chrome real con depuración (PRIORIDAD 2). Si FANSLY_TOKEN está vacío y Chrome
# responde aquí, el MCP reutiliza tu sesión de fansly.com ya iniciada.
# Actívalo con: npm run chrome-cdp
FANSLY_CDP_URL="http://127.0.0.1:9222"

# Multi-cuenta (varias modelos). JSON con una entrada por cuenta:
#   "nombre": { "cdpUrl": "http://127.0.0.1:PUERTO", "userDataDir": "RUTA_PERFIL" }
# Cada modelo usa un puerto de depuración y un perfil propios (npm run chrome-cdp -- <nombre>).
FANSLY_ACCOUNTS='{"luna":{"cdpUrl":"http://127.0.0.1:9222","userDataDir":"./browser_data/luna"},"maria":{"cdpUrl":"http://127.0.0.1:9223","userDataDir":"./browser_data/maria"}}'
FANSLY_ACTIVE_ACCOUNT="luna"

# Tiempo máximo (ms) de espera para que inicies sesión en el navegador cuando no hay sesión
LOGIN_WAIT_MS="120000"

# Número máximo de reintentos del motor resiliente
MAX_RETRIES="3"

# Base del backoff exponencial en milisegundos
BACKOFF_BASE_MS="1000"

# Timeout por petición HTTP en milisegundos
REQUEST_TIMEOUT_MS="30000"

# Intervalo (ms) del scheduler de snapshot automático. 0 = desactivado.
# Ejemplo diario: 86400000
SNAPSHOT_INTERVAL_MS="0"
